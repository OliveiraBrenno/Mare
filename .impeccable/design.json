      "css": ".ds-nav{display:flex;flex-wrap:wrap;gap:30px;color:var(--navy,#092638);font:700 11px \"DM Sans\",sans-serif;letter-spacing:.15em;text-transform:uppercase}.ds-nav a{position:relative;color:inherit;text-decoration:none}.ds-nav a:after{content:\"\";position:absolute;bottom:-5px;left:0;width:100%;height:1px;background:currentColor;transform:scaleX(0);transform-origin:left;transition:transform .3s}.ds-nav a:hover:after{transform:scaleX(1)}.ds-nav a:focus-visible{outline:2px solid #b85a37;outline-offset:5px}"
