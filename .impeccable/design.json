      "css": ".ds-label{display:grid;gap:8px;color:var(--navy,#092638);font:600 12px \"DM Sans\",sans-serif}.ds-input{height:45px;width:100%;border:0;border-bottom:1px solid #a79b84;border-radius:0;background:transparent;padding:0 4px;color:var(--navy,#092638);font:400 14px \"DM Sans\",sans-serif;caret-color:#ac6d32}.ds-input::placeholder{color:#6c6354}.ds-input:hover{border-bottom-color:var(--navy,#092638)}.ds-input:focus-visible{outline:2px solid #b85a37;outline-offset:5px}"
