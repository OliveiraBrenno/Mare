      "html": "<button class=\"ds-primary\">Fazer reserva <svg viewBox=\"0 0 24 16\" width=\"25\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.2\" aria-hidden=\"true\"><path d=\"M1 8h21M15 1l7 7-7 7\"/></svg></button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:space-between;gap:35px;border:0;border-radius:25px;padding:14px 25px;background:var(--gold,#f1b633);color:var(--navy,#092638);font:700 11px \"DM Sans\",sans-serif;letter-spacing:.18em;text-transform:uppercase;cursor:pointer;transition:background .3s,transform .3s}.ds-primary:hover{background:#ffcc58;transform:translateY(-2px)}.ds-primary:active{transform:translateY(0)}.ds-primary:focus-visible{outline:2px solid #b85a37;outline-offset:5px}"
